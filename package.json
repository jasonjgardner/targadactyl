{
  "name": "targadactyl",
  "version": "2.2.0",
  "description": "TGA (Targa) image loader for Node.js and Bun",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./reader": {
      "types": "./dist/src/reader.d.ts",
      "import": "./dist/src/reader.js"
    },
    "./writer": {
      "types": "./dist/src/writer.d.ts",
      "import": "./dist/src/writer.js"
    },
    "./loader": {
      "types": "./dist/src/tga.d.ts",
      "import": "./dist/src/tga.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "import": "./dist/src/errors.js"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "test": "npm run build && node --test dist/src/tga_test.js dist/src/writer_test.js dist/src/reader_test.js",
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "example": "npm run build && node examples/basic-usage.js"
  },
  "keywords": [
    "tga",
    "targa"
  ],
  "author": "-jason",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonjgardner/targadactyl.git"
  },
  "bugs": {
    "url": "https://github.com/jasonjgardner/targadactyl/issues"
  },
  "homepage": "https://github.com/jasonjgardner/targadactyl#readme",
  "dependencies": {
    "skia-canvas": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
